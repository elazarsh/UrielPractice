# ════════════════════════════════════════════════════════
# UrielPractice – .gitignore
# ⚠️  קבצים רגישים שלעולם לא נכנסים ל-git
# ════════════════════════════════════════════════════════

# ─── Dependencies ─────────────────────────────────────
node_modules/
.turbo/

# ─── Build outputs ────────────────────────────────────
dist/
coverage/

# ─── Uploads ──────────────────────────────────────────
uploads/
bots/reports/

# ─── Logs ─────────────────────────────────────────────
*.log

# ─── OS ───────────────────────────────────────────────
.DS_Store

# ─── 🔐 SECRETS & ENVIRONMENT – לעולם לא ב-git! ──────
# כל קבצי .env (רגישים)
.env
.env.*

# אפשר קבצי תבנית בלבד (ללא ערכים אמיתיים)
!.env.example
!.env.*.example
