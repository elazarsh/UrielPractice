# ════════════════════════════════════════════════════════
# UrielPractice – תבנית משתני סביבה
# העתק לקובץ .env ומלא את הערכים האמיתיים
# ════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────
POSTGRES_DB=uriel_practice
POSTGRES_USER=uriel
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ─── Backend ──────────────────────────────────────────
# שנה את הסיסמא בהתאם ל-POSTGRES_PASSWORD
DATABASE_URL=postgresql://uriel:CHANGE_ME_strong_password_here@postgres:5432/uriel_practice
# צור secret אקראי: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_min_32_chars_random_secret_here_use_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_different_random_secret_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3001
NODE_ENV=production
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# ─── Frontend ─────────────────────────────────────────
# כתובת ה-backend כפי שהדפדפן רואה אותה
VITE_API_URL=http://localhost:3001
