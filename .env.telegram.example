# השליח – הגדרות Telegram Bot
# העתק לקובץ .env.telegram והכנס את הערכים האמיתיים

# 1. צור בוט ב-@BotFather בטלגרם
# 2. שלח /newbot → קבל Token
TELEGRAM_BOT_TOKEN="123456789:AAF_replace_with_your_actual_token"

# 3. שלח הודעה לבוט שיצרת
# 4. פתח: https://api.telegram.org/bot<TOKEN>/getUpdates
# 5. העתק את chat.id מהתגובה
TELEGRAM_CHAT_ID="123456789"
